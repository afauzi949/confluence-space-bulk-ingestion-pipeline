# ---- Confluence ----
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# satu atau lebih space key, pisah koma
CONFLUENCE_SPACE_KEYS=II
CONTENT_PAGE_LIMIT=50

# ---- Metadata yang dikirim ke convert API ----
PAGE_TYPE=page

# ---- Convert HTML -> Markdown (API eksternal) ----
CONVERT_API_URL=

# ---- Chunking (API eksternal) ----
CHUNK_API_URL=
CHUNK_SIZE=6000
CHUNK_OVERLAP=200

# ---- Embedding dense (API eksternal, OpenAI-compatible) ----
EMBEDDING_API_URL=https://ai.sumopod.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# jumlah chunk per request embedding
EMBEDDING_BATCH_SIZE=10

# ---- Qdrant ----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
# sparse BM25 dihitung oleh Qdrant (inference object)
QDRANT_SPARSE_MODEL=qdrant/bm25

# ---- HTTP ----
HTTP_TIMEOUT_SECONDS=120
HTTP_MAX_TRIES=3
HTTP_RETRY_WAIT_SECONDS=5

LOG_LEVEL=INFO
